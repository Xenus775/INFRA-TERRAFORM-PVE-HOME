# Copiez ce fichier en terraform.tfvars (jamais commite, voir .gitignore) et completez les valeurs reelles.

proxmox_endpoint         = "https://192.168.10.160:8006/"
proxmox_api_token_id     = "terraform_provisioner@pve!provisioner"
proxmox_api_token_secret = "REPLACE_ME"

proxmox_node = "PVE-INFRA-MATT-01"

# Cle publique du keypair dedie injecte via Cloud-Init (ne jamais mettre la cle privee ici)
ssh_public_key = "ssh-ed25519 AAAA... commentaire"

# SSH vers le noeud Proxmox lui-meme, necessaire uniquement pour l'import du
# disque du template (limitation de l'API, voir DECISIONS.txt). Cle dediee,
# distincte de ssh_public_key ci-dessus. Le chemin pointe vers un fichier
# LOCAL, jamais commite.
pve_ssh_username         = "root"
pve_ssh_private_key_path = "~/.ssh/id_ed25519_pve_host_terraform"
